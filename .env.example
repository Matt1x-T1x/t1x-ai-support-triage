# Porta HTTP do servidor
PORT=3003

# Caminho do banco SQLite
DATABASE_PATH=./data/triage.db

# Provedor de IA: "gemini" ou "heuristic" (padrão local sem chave para testes/demos)
AI_PROVIDER=heuristic

# Opcional: chave da Gemini API quando AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
